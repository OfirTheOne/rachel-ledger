# Neon Postgres connection strings (pooled for runtime, direct for migrations)
DATABASE_URL="postgresql://user:pass@host-pooler/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"
# Google Gemini API key (server-side only)
GEMINI_API_KEY="your-key-here"
# Password gate — when set, the app is locked behind /login. Empty = disabled.
APP_PASSWORD="choose-a-password"
